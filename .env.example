# ---------------------------------------------------------------- database ---
# Leave DATABASE_URL unset for local development. The app then runs on PGlite —
# Postgres compiled to WASM, running in-process and persisted to ./triptogether.db.
# No server, no account, no Docker. Same SQL as production.
#
# Set it to a Postgres URL to use a real database. For Supabase, copy the string
# from Project Settings → Database → Connection string, and put YOUR OWN
# password in it. Never commit this file with a real password in it.
#
# Use the *session pooler* (port 5432) or the *transaction pooler* (port 6543).
# Serverless platforms like Vercel should use the transaction pooler:
#
#   DATABASE_URL=postgresql://postgres.bcmdgasjjdfwplcwilvb:YOUR-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
#
# DATABASE_URL=

# The Postgres schema this app owns. Everything it creates lives inside it, so
# the database can hold other things too. Defaults to "triptogether".
# DATABASE_SCHEMA=triptogether

# ------------------------------------------------------------------ secrets ---
# Signs the cookie that says which participant a browser is. Anyone who knows it
# can forge an identity on any trip, so generate a real one for anything that is
# not a local demo:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing it signs everyone out; it does not lose any data.
TRIPTOGETHER_SECRET=dev-secret-change-me
